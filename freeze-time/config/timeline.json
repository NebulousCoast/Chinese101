    { "id": "question", "start": 0.0,  "end": 2.0,  "style": "question", "text": "What if I could freeze time whenever I wanted?" },
    { "id": "beat2",    "start": 2.0,  "end": 7.8,  "style": "lower",    "text": "I pause the world. It costs me 1 second per second." },
    { "id": "beat3",    "start": 8.0,  "end": 14.8, "style": "lower",    "text": "Step one: cookies. Harmless, right?" },
    { "id": "beat4",    "start": 15.0, "end": 21.8, "style": "lower",    "text": "Step two: freeze the teacher to cheat." },
    { "id": "beat5",    "start": 22.0, "end": 29.8, "style": "lower",    "text": "Step three: things get stuck when I stop them." },
    { "id": "beat6",    "start": 30.0, "end": 39.8, "style": "lower",    "text": "Step four: I froze someone and left them there." },
    { "id": "beat7",    "start": 40.0, "end": 47.8, "style": "lower",    "text": "I can’t stop. I don’t know how to stop." },
    { "id": "final",    "start": 50.5, "end": 57.0, "style": "card",     "text": "What if you couldn’t unfreeze it?" }
  ],

  "vo": [
    { "beat": 1, "file": "assets/audio/vo/beat_01.wav", "start": 0.3,  "line": "I found out I could." },
